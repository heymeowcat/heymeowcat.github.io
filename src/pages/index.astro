---
import "../styles/global.css";

const nav = [
	{ label: "GitHub", href: "https://github.com/heymeowcat", external: true },
	{ label: "LinkedIn", href: "https://linkedin.com/in/vidura-fernando", external: true },
	{ label: "Resume", href: "/resume/" },
];

const roles = [
	{
		title: "Software Engineer",
		org: "Virtusa",
		location: "Colombo",
		dates: "Oct 2023 — Present",
		points: [
			"Architected and scaled enterprise mobile applications using React Native, TypeScript and Redux, for clients in multiple markets.",
			"Engineered custom native Android modules and optimised UI-thread rendering, reaching 60fps animations and 35% faster startup times.",
			"Integrated REST and GraphQL APIs with client-side caching, offline sync and secure state persistence.",
			"Mentored engineers on React Native upgrades, state management architecture and automated testing.",
		],
	},
	{
		title: "Associate Software Engineer",
		org: "Virtusa",
		location: "Colombo",
		dates: "Feb 2022 — Oct 2023",
		points: [
			"Built modular React Native components and managed complex state flows with Redux and TypeScript.",
			"Delivered features on sprint cadence while holding code quality and test coverage standards.",
			"Resolved critical rendering bugs and Android device compatibility issues.",
		],
	},
];

const work = [
	{
		name: "CleanBoard",
		description:
			"A minimalist Android keyboard for Sinhala and English — phonetic Singlish with live suggestions, plus a traditional Sinhala layout. No data collection, and no internet permission at all.",
		tags: "Android · Keyboard IME · Sinhala",
		href: "https://play.google.com/store/apps/details?id=com.heymeowcat.cleanboard",
		links: [
			{
				label: "Site",
				href: "https://heymeowcat.is-a.dev/cleanboard-site/",
				aria: "CleanBoard Site",
			},
		],
	},
	{
		name: "SoundDrift",
		description:
			"Streams audio from an Android device to Windows, macOS or Linux over UDP, with the desktop client auto-discovering the phone on the network. Free and open source.",
		tags: "Kotlin · Audio · Networking",
		href: "https://play.google.com/store/apps/details?id=com.heymeowcat.sounddrift",
		links: [
			{
				label: "Repo",
				href: "https://github.com/heymeowcat/SoundDrift",
				aria: "SoundDrift Repo",
			},
		],
	},
	{
		name: "WifiHeatmap",
		description:
			"An Android Wi-Fi site survey tool. Walk a floor plan while it fuses step detection and heading sensors into an RF coverage heatmap, then rate channels across 2.4, 5 and 6 GHz. Runs fully offline, with no telemetry.",
		tags: "Android · Wi-Fi · Sensor fusion",
		href: "https://play.google.com/store/apps/details?id=com.heymeowcat.wifiheatmap",
		links: [
			{
				label: "Site",
				href: "https://heymeowcat.is-a.dev/wifiheatmap-site/",
				aria: "WifiHeatmap Site",
			},
		],
	},
	{
		name: "NoteGuard",
		description:
			"An offline notes app where every note is a plain Markdown file in a folder you choose, encrypted with a key derived from your PIN, with a local model for chat, semantic search and summaries. No account, no server, no upload.",
		tags: "Android · On-device AI · Encryption",
		href: "https://play.google.com/store/apps/details?id=com.heymeowcat.list",
		links: [
			{
				label: "Site",
				href: "https://heymeowcat.is-a.dev/noteguard-site/",
				aria: "NoteGuard Site",
			},
		],
	},
	{
		name: "RN Safe Upgrade",
		description:
			"Compares two React Native versions, diffs the dependency files, and flags the changes that will break the upgrade before you run it.",
		tags: "TypeScript · Tooling · React Native",
		href: "https://heymeowcat.is-a.dev/rn-safe-upgrade/",
		links: [],
	},
];

const also = [
	{
		name: "Sinhala Commons",
		description:
			"A 42.3M-sentence open corpus for Sinhala NLP, with a licence audit for every source.",
		href: "https://huggingface.co/datasets/heymeowcat/sinhala-commons",
		links: [
			{
				label: "Repo",
				href: "https://github.com/heymeowcat/sinhala-commons-code",
				aria: "Sinhala Commons Repo",
			},
		],
	},
	{
		name: "DocSync",
		description:
			"A GitHub App that finds documentation drift in a pull request and posts a reviewable report.",
		href: "https://github.com/heymeowcat/DocSync",
		links: [],
	},
	{
		name: "MeowUI",
		description: "A React Native component library with comic-style motion.",
		href: "https://www.npmjs.com/package/react-native-meowui",
		links: [],
	},
	{
		name: "MasonryGridView",
		description: "A React Native masonry layout component.",
		href: "https://www.npmjs.com/package/react-native-masonry-gridview",
		links: [],
	},
];

const stack = [
	{
		label: "Mobile",
		items:
			"React Native, Kotlin, Java, Android, React Navigation, Redux Toolkit, Detox",
	},
	{
		label: "Web",
		items: "TypeScript, React, Node.js, Express, Astro",
	},
	{
		label: "AI / ML",
		items:
			"On-device inference, ExecuTorch, NLP datasets, LLM tooling, MCP servers, RAG",
	},
	{
		label: "Infra",
		items:
			"AWS, Docker, GitHub Actions, CI/CD, Play Console, npm, Hugging Face",
	},
];

const education = [
	{
		degree: "BSc (Hons) Software Engineering",
		school: "Birmingham City University",
		years: "2016 — 2022",
	},
	{
		degree: "Ordinary Level · Advanced Level",
		school: "Bandaranayake College, Gampaha",
		years: "2011 — 2019",
	},
];

const certifications = [
	{
		name: "AWS Certified Solutions Architect — Associate",
		issuer: "Amazon Web Services",
		years: "2025 — 2028",
	},
	{
		name: "AWS Certified AI Practitioner",
		issuer: "Amazon Web Services",
		years: "2025 — 2028",
	},
];

const site = "https://heymeowcat.is-a.dev";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light dark" />

		<title>Vidura Fernando — Mobile App Developer &amp; AI Engineer</title>
		<meta
			name="description"
			content="Vidura Fernando is a mobile app developer and AI engineer in Colombo, Sri Lanka. Builds React Native and native Android apps, on-device models and NLP tooling."
		/>
		<meta name="author" content="Vidura Fernando" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={site} />

		<meta property="og:type" content="profile" />
		<meta property="og:url" content={site} />
		<meta property="og:title" content="Vidura Fernando" />
		<meta
			property="og:description"
			content="Mobile app developer and AI engineer. React Native, native Android, on-device models, Sinhala NLP."
		/>
		<meta property="og:image" content={`${site}/og.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Vidura Fernando" />
		<meta
			name="twitter:description"
			content="Mobile app developer and AI engineer. React Native, native Android, on-device models, Sinhala NLP."
		/>
		<meta name="twitter:image" content={`${site}/og.png`} />

		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "Person",
				name: "Vidura Fernando",
				alternateName: "heymeowcat",
				url: site,
				jobTitle: "Mobile App Developer and AI Engineer",
				description:
					"Mobile app developer and AI engineer specialising in React Native, native Android, on-device machine learning and Sinhala NLP.",
				sameAs: [
					"https://github.com/heymeowcat",
					"https://linkedin.com/in/vidura-fernando",
				],
				worksFor: {
					"@type": "Organization",
					name: "Virtusa",
				},
				address: {
					"@type": "PostalAddress",
					addressLocality: "Colombo",
					addressCountry: "LK",
				},
				alumniOf: {
					"@type": "CollegeOrUniversity",
					name: "Birmingham City University",
				},
				knowsAbout: [
					"React Native",
					"Android",
					"Kotlin",
					"TypeScript",
					"Python",
					"On-device AI",
					"NLP",
				],
			})}
		/>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="icon"
			type="image/png"
			sizes="32x32"
			href="/favicon-32x32.png"
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="16x16"
			href="/favicon-16x16.png"
		/>
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>

		<header class="site-head">
			<div class="wrap head-row">
				<div>
					<h1 class="name">Vidura Fernando</h1>
					<p class="role">
						Mobile app developer &amp; AI engineer · Colombo, Sri Lanka
					</p>
				</div>
				<nav class="nav" aria-label="Primary">
					{
						nav.map((item) => (
							<a
								href={item.href}
								target={item.external ? "_blank" : undefined}
								rel={item.external ? "noopener noreferrer" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
			</div>
		</header>

		<main id="main">
			<section class="intro">
				<div class="wrap">
					<p class="lede">
						Mobile app developer and AI engineer in Colombo, Sri Lanka.
						Four years shipping React Native and native Android in production,
						now working across TypeScript, Kotlin and Python on on-device
						models, Sinhala NLP and developer tooling.
					</p>
					<p class="lede dim">
						Most of it is offline-first work: apps that keep working without a
						network, and models that run on the device instead of in someone
						else's cloud.
					</p>
					<div class="cta-row">
						<a class="btn" href="/resume/">
							Resume <span class="arrow">→</span>
						</a>
						<span class="meta-note">Last updated October 2026</span>
					</div>
				</div>
			</section>

			<section id="experience">
				<div class="wrap">
					<h2 class="eyebrow">Experience</h2>
					{
						roles.map((role) => (
							<div class="role">
								<div class="role-head">
									<h3>{role.title}</h3>
									<span class="role-org">
										{role.org} · {role.location}
									</span>
									<span class="role-dates">{role.dates}</span>
								</div>
								<ul class="bullets">
									{role.points.map((point) => (
										<li>{point}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</section>

			<section id="work">
				<div class="wrap">
					<h2 class="eyebrow">Work</h2>
					<ul class="work">
						{
							work.map((item) => (
								<li class="work">
									<div class="work-head">
										<h3 class="work-title">
											<a
												href={item.href}
												target="_blank"
												rel="noopener noreferrer"
											>
												{item.name}
											</a>
										</h3>
										{item.links.length > 0 && (
											<div class="work-links">
												{item.links.map((link) => (
													<a
														href={link.href}
														target="_blank"
														rel="noopener noreferrer"
														aria-label={link.aria}
													>
														{link.label}
													</a>
												))}
											</div>
										)}
									</div>
									<p class="work-desc">{item.description}</p>
									<p class="work-tags">{item.tags}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<section id="open-source">
				<div class="wrap">
					<h2 class="eyebrow">Open source</h2>
					<ul class="also">
						{
							also.map((item) => (
								<li>
									<a
										class="also-title"
										href={item.href}
										target="_blank"
										rel="noopener noreferrer"
									>
										{item.name}
									</a>
									<span class="also-desc">{item.description}</span>
									{item.links.length > 0 && (
										<span class="also-links">
											{item.links.map((link) => (
												<a
													href={link.href}
													target="_blank"
													rel="noopener noreferrer"
													aria-label={link.aria}
												>
													{link.label}
												</a>
											))}
										</span>
									)}
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<section id="stack">
				<div class="wrap">
					<h2 class="eyebrow">Stack</h2>
					<dl>
						{
							stack.map((row) => (
								<div class="spec-row">
									<dt>{row.label}</dt>
									<dd>{row.items}</dd>
								</div>
							))
						}
					</dl>
				</div>
			</section>

			<section id="background">
				<div class="wrap split">
					<div>
						<h2 class="eyebrow">Education</h2>
						{
							education.map((row) => (
								<div class="mini">
									<strong>{row.degree}</strong>
									<p class="mini-sub">
										{row.school} · {row.years}
									</p>
								</div>
							))
						}
					</div>
					<div>
						<h2 class="eyebrow">Certifications</h2>
						{
							certifications.map((row) => (
								<div class="mini">
									<strong>{row.name}</strong>
									<p class="mini-sub">
										{row.issuer} · {row.years}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-foot">
			<div class="wrap foot-row">
				<p>© 2026 Vidura Fernando</p>
				<p>
					<a
						href="https://github.com/heymeowcat"
						target="_blank"
						rel="noopener noreferrer">github.com/heymeowcat</a
					>
				</p>
			</div>
		</footer>
	</body>
</html>
